{
  "$schema": "https://schemas.tokens.studio/latest/token-schema.json",
  "meta": {
    "name": "Mabar Design System",
    "version": "1.0.0",
    "platform": ["flutter", "web"]
  },
  "color": {
    "brand": {
      "primary":       { "value": "#16A34A", "type": "color", "description": "Hijau lapangan — CTA utama, active state" },
      "primaryDark":   { "value": "#14532D", "type": "color", "description": "Header, brand mark" },
      "primaryTint":   { "value": "#F0FDF4", "type": "color", "description": "Background soft, selected state" },
      "primaryBorder": { "value": "#BBF7D0", "type": "color", "description": "Border soft accent" }
    },
    "semantic": {
      "success":       { "value": "#16A34A", "type": "color" },
      "successTint":   { "value": "#F0FDF4", "type": "color" },
      "warning":       { "value": "#F59E0B", "type": "color", "description": "Live/sementara/rest state" },
      "warningTint":   { "value": "#FEF3C7", "type": "color" },
      "warningBorder": { "value": "#FDE68A", "type": "color" },
      "danger":        { "value": "#EF4444", "type": "color", "description": "WO, delete, stop" },
      "dangerTint":    { "value": "#FEF2F2", "type": "color" },
      "dangerBorder":  { "value": "#FECACA", "type": "color" },
      "info":          { "value": "#3B82F6", "type": "color" },
      "infoTint":      { "value": "#EFF6FF", "type": "color" }
    },
    "court": {
      "1": { "value": "#16A34A", "type": "color" },
      "2": { "value": "#DC2626", "type": "color" },
      "3": { "value": "#2563EB", "type": "color" },
      "4": { "value": "#EA580C", "type": "color" },
      "5": { "value": "#9333EA", "type": "color" },
      "6": { "value": "#0891B2", "type": "color" },
      "7": { "value": "#DB2777", "type": "color" },
      "8": { "value": "#65A30D", "type": "color" },
      "9": { "value": "#7C3AED", "type": "color" },
      "10": { "value": "#0D9488", "type": "color" }
    },
    "surface": {
      "background": { "value": "#FAFAFA", "type": "color", "description": "App background" },
      "card":       { "value": "#FFFFFF", "type": "color", "description": "Card fill" },
      "raised":     { "value": "#F9FAFB", "type": "color", "description": "Subtle raise (input group, info box)" },
      "muted":      { "value": "#F3F4F6", "type": "color", "description": "Chip, disabled" }
    },
    "border": {
      "default": { "value": "#E5E7EB", "type": "color" },
      "subtle":  { "value": "#F3F4F6", "type": "color" },
      "strong":  { "value": "#D1D5DB", "type": "color" },
      "focus":   { "value": "#16A34A", "type": "color" }
    },
    "text": {
      "primary":   { "value": "#111827", "type": "color", "description": "Heading, angka besar" },
      "secondary": { "value": "#374151", "type": "color", "description": "Body" },
      "tertiary":  { "value": "#6B7280", "type": "color", "description": "Label, sub-text" },
      "quaternary":{ "value": "#9CA3AF", "type": "color", "description": "Hint, timestamp" },
      "disabled":  { "value": "#D1D5DB", "type": "color" },
      "inverse":   { "value": "#FFFFFF", "type": "color", "description": "Text di atas primary bg" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif", "type": "fontFamilies" },
      "mono": { "value": "'JetBrains Mono', 'SF Mono', Menlo, monospace", "type": "fontFamilies" }
    },
    "fontSize": {
      "xs":   { "value": "11px", "type": "fontSizes" },
      "sm":   { "value": "12px", "type": "fontSizes" },
      "base": { "value": "14px", "type": "fontSizes" },
      "md":   { "value": "15px", "type": "fontSizes" },
      "lg":   { "value": "17px", "type": "fontSizes" },
      "xl":   { "value": "20px", "type": "fontSizes" },
      "2xl":  { "value": "24px", "type": "fontSizes" },
      "3xl":  { "value": "28px", "type": "fontSizes" },
      "4xl":  { "value": "36px", "type": "fontSizes" },
      "display": { "value": "48px", "type": "fontSizes" }
    },
    "fontWeight": {
      "regular":  { "value": "400", "type": "fontWeights" },
      "medium":   { "value": "500", "type": "fontWeights" },
      "semibold": { "value": "600", "type": "fontWeights" },
      "bold":     { "value": "700", "type": "fontWeights" },
      "extrabold":{ "value": "800", "type": "fontWeights" }
    },
    "lineHeight": {
      "tight":  { "value": "1.2", "type": "lineHeights" },
      "normal": { "value": "1.5", "type": "lineHeights" },
      "relaxed":{ "value": "1.7", "type": "lineHeights" }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.5px", "type": "letterSpacing" },
      "normal": { "value": "0", "type": "letterSpacing" },
      "wide":   { "value": "0.5px", "type": "letterSpacing" }
    }
  },
  "spacing": {
    "0":  { "value": "0", "type": "spacing" },
    "1":  { "value": "4px", "type": "spacing" },
    "2":  { "value": "8px", "type": "spacing" },
    "3":  { "value": "12px", "type": "spacing" },
    "4":  { "value": "16px", "type": "spacing" },
    "5":  { "value": "20px", "type": "spacing" },
    "6":  { "value": "24px", "type": "spacing" },
    "8":  { "value": "32px", "type": "spacing" },
    "10": { "value": "40px", "type": "spacing" },
    "12": { "value": "48px", "type": "spacing" }
  },
  "radius": {
    "sm":   { "value": "6px", "type": "borderRadius" },
    "md":   { "value": "8px", "type": "borderRadius" },
    "lg":   { "value": "10px", "type": "borderRadius" },
    "xl":   { "value": "12px", "type": "borderRadius" },
    "2xl":  { "value": "16px", "type": "borderRadius" },
    "3xl":  { "value": "20px", "type": "borderRadius" },
    "full": { "value": "9999px", "type": "borderRadius" }
  },
  "shadow": {
    "sm":  { "value": "0 1px 2px rgba(17,24,39,0.04)", "type": "boxShadow" },
    "md":  { "value": "0 2px 8px rgba(17,24,39,0.06), 0 1px 2px rgba(17,24,39,0.04)", "type": "boxShadow" },
    "lg":  { "value": "0 8px 24px rgba(17,24,39,0.08), 0 2px 6px rgba(17,24,39,0.04)", "type": "boxShadow" },
    "xl":  { "value": "0 20px 40px rgba(17,24,39,0.10), 0 4px 12px rgba(17,24,39,0.06)", "type": "boxShadow" },
    "brand":{ "value": "0 4px 14px rgba(22,163,74,0.25)", "type": "boxShadow", "description": "Primary CTA button shadow" }
  },
  "component": {
    "button": {
      "primary": {
        "background": { "value": "{color.brand.primary}", "type": "color" },
        "text": { "value": "{color.text.inverse}", "type": "color" },
        "radius": { "value": "{radius.xl}", "type": "borderRadius" },
        "height": { "value": "52px", "type": "sizing" },
        "shadow": { "value": "{shadow.brand}", "type": "boxShadow" }
      },
      "secondary": {
        "background": { "value": "transparent", "type": "color" },
        "text": { "value": "{color.text.primary}", "type": "color" },
        "border": { "value": "{color.border.default}", "type": "color" }
      }
    },
    "card": {
      "background": { "value": "{color.surface.card}", "type": "color" },
      "radius": { "value": "{radius.xl}", "type": "borderRadius" },
      "shadow": { "value": "{shadow.md}", "type": "boxShadow" },
      "padding": { "value": "{spacing.4}", "type": "spacing" }
    },
    "input": {
      "background": { "value": "{color.surface.card}", "type": "color" },
      "border": { "value": "{color.border.default}", "type": "color" },
      "borderFocus": { "value": "{color.brand.primary}", "type": "color" },
      "radius": { "value": "{radius.lg}", "type": "borderRadius" },
      "height": { "value": "44px", "type": "sizing" }
    },
    "chip": {
      "background": { "value": "{color.surface.muted}", "type": "color" },
      "backgroundActive": { "value": "{color.brand.primary}", "type": "color" },
      "text": { "value": "{color.text.secondary}", "type": "color" },
      "textActive": { "value": "{color.text.inverse}", "type": "color" },
      "radius": { "value": "{radius.full}", "type": "borderRadius" }
    }
  },
  "flutterHint": {
    "notes": [
      "Setiap alias {token.path} di file ini bisa di-resolve otomatis dengan build_runner + token pipeline (misal `theme_tailor` atau custom script).",
      "Warna → gunakan Color(0xFF + hex) di Dart.",
      "Font: pakai google_fonts atau bundle Inter TTF di assets/fonts.",
      "Radius/spacing → simpan sebagai const di ThemeData extension.",
      "Court color: pakai indeks (courts[i % 10]) untuk assign warna otomatis."
    ]
  }
}
